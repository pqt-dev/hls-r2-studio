{
    "name": "hls-r2-studio-desktop",
    "version": "0.1.0",
    "private": true,
    "description": "HLS R2 Studio desktop app",
    "author": "HLS R2 Studio",
    "productName": "HLS R2 Studio",
    "appId": "com.hlsr2studio.desktop",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "smoke": "rolldown scripts/pipeline-smoke.ts --platform node --format esm --external @aws-sdk/client-s3 --dir .smoke-out --entryFileNames pipeline-smoke.mjs && node .smoke-out/pipeline-smoke.mjs",
        "pack": "npm run build && electron-builder --dir",
        "dist:win": "npm run build && electron-builder --win nsis --x64",
        "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
        "gen:notices": "node scripts/gen-notices.mjs",
        "predist:win": "npm run fetch:ffmpeg && npm run gen:notices",
        "verify:dist": "node scripts/verify-dist.mjs"
    },
    "devDependencies": {
        "@electron/asar": "^3.4.1",
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/yauzl": "^3.4.0",
        "@vitejs/plugin-react": "^6.2.1",
        "electron": "^45.2.1",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "license-checker-rseidelsohn": "^5.0.1",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.1.0",
        "yauzl": "^3.4.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1161.0"
    }
}
